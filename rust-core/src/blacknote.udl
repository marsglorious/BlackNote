namespace blacknote {
    ParsedDoc parse_markdown(string src);
    string apply_format(string src, u32 sel_start, u32 sel_end, FormatKind kind, boolean on);
    NoteMeta extract_meta(string path, string parent, string file_name, string text, i64 modified_millis);
    sequence<NoteMeta> search_notes(sequence<NoteMeta> notes, string query, u32 limit);
    sequence<FuzzyResult> fuzzy_search(sequence<NoteMeta> notes, string query, u32 limit);
};

dictionary FuzzyResult {
    NoteMeta note;
    sequence<u32> title_matches;
    sequence<u32> preview_matches;
};

enum FormatKind {
    "Bold",
    "Italic",
    "Underline",
    "Strike",
    "Code",
    "BulletList",
    "OrderedList",
};

dictionary StyledSpan {
    u32 start;
    u32 end;
    SpanStyle style;
};

[Enum]
interface SpanStyle {
    Bold();
    Italic();
    Underline();
    Strike();
    Code();
    Heading(u8 level);
    BulletItem();
    OrderedItem(u32 number);
    Link(string url);
    BlockQuote();
};

dictionary ParsedDoc {
    string plain;
    sequence<StyledSpan> spans;
};

dictionary NoteMeta {
    string path;
    string parent;
    string title;
    string preview;
    i64 modified_millis;
    i64 created_millis;
    sequence<string> tags;
    string? label;
};

interface SearchIndex {
    [Throws=IndexError]
    constructor(string db_path);

    [Throws=IndexError]
    void upsert(string path, string parent, string title, string body, string? label, sequence<string> tags, i64 modified_millis, i64 created_millis);

    [Throws=IndexError]
    void delete(string path);

    [Throws=IndexError]
    sequence<NoteMeta> query(string q, u32 limit);

    [Throws=IndexError]
    sequence<NoteMeta> all_sorted(u32 limit);

    [Throws=IndexError]
    void retain(sequence<string> alive_paths);
};

[Error]
enum IndexError {
    "Sqlite",
    "Io",
};
